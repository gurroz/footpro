{
  "expo": {
    "name": "FootPro",
    "slug": "footpro",
    "version": "0.0.1",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.footpro",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "FootPro reads your contacts so you can add players to a team.",
        "NSPhotoLibraryUsageDescription": "FootPro uses your photo library so you can choose a team logo."
      }
    },
    "android": {
      "package": "com.footpro",
      "permissions": ["READ_CONTACTS", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/react-native-vector-icons/Fonts/MaterialIcons.ttf"
          ]
        }
      ]
    ]
  }
}
